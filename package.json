{
  "name": "market-time-machine",
  "version": "0.2.0",
  "private": true,
  "description": "Travel to any date in market history and invest using only what was knowable that day.",
  "author": "jtouevsky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jtouevsky/market-time-machine.git"
  },
  "keywords": [
    "finance",
    "stock-market",
    "history",
    "simulation",
    "react",
    "typescript",
    "vite"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:refresh": "node scripts/data/build-all.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^1.6.0"
  }
}
