# Market Time Machine — optional settings. NOTHING here is required to run the app.
# Copy this file to `.env` and change what you need. `.env` is git-ignored.
#
# There are no API keys: every data source is free and keyless. Market, economic,
# news, sports and culture data ship pre-built in public/data.

# --- App (read by Vite at build/dev time; must start with VITE_) ---

# Show [REAL] / [ARCHIVAL] / [DERIVED] / [MOCK] provenance badges everywhere.
# (In the app you can also press Shift+D, or add ?debug=1 to the URL.)
VITE_DEBUG_LABELS=false

# Live keyless lookups made from the browser: NOAA daily weather and Library of
# Congress newspaper front pages. Set to false for a fully offline app.
VITE_LIVE_SOURCES=true

# --- Data build (only used by `npm run data:refresh`) ---

# Contact info sent in the User-Agent header, as Wikipedia's API policy asks.
# Put your own email or URL here if you rebuild the datasets.
DATA_CONTACT=you@example.com
