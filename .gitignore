# Dependencies
node_modules/

# Build output (regenerate with `npm run build` / `npm run build:single`)
dist/
dist-single/
market-time-machine-standalone.html

# Raw HTTP cache from `npm run data:refresh` (hundreds of MB; the processed
# results in public/data ARE committed so the app runs straight after cloning)
.data-cache/

# Local environment and secrets — never commit these
.env
.env.*
!.env.example

# Logs and tool leftovers
*.log
npm-debug.log*
vite.config.ts.timestamp-*
coverage/
.vitest/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
